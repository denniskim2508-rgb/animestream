rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function validAuthorName(name) {
      return name is string && name.size() > 0 && name.size() <= 30;
    }

    function validCommentText(text) {
      return text is string && text.size() >= 2 && text.size() <= 500;
    }

    // Comments and replies must be posted by the signed-in author using their
    // own profile identity, with a fixed, typed payload (no forged likes,
    // pin flags, timestamps, or privileged fields).
    function canCreateComment(allowedKeys) {
      return isSignedIn() &&
        request.auth.uid is string &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.uid is string &&
        userProfile().exists &&
        request.resource.data.name == userProfile().data.name &&
        validAuthorName(request.resource.data.name) &&
        validCommentText(request.resource.data.text) &&
        request.resource.data.avatar is string &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.likes == 0 &&
        request.resource.data.dislikes == 0 &&
        request.resource.data.likedBy.size() == 0 &&
        request.resource.data.dislikedBy.size() == 0 &&
        request.resource.data.keys().hasOnly(allowedKeys);
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Profile documents are created with a fixed shape only, and privilege /
      // vanity fields are pinned to safe defaults so a client can't register
      // with plan:'premium' or inflated stats.
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'name', 'email', 'avatar', 'avatarName', 'plan', 'joinDate',
          'favorites', 'watchlist', 'continueWatching', 'watchMinutes',
          'badges', 'commentsPosted', 'accent', 'createdAt',
        ]) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 30 &&
        request.resource.data.email is string &&
        request.resource.data.avatar is string &&
        request.resource.data.avatarName is string &&
        request.resource.data.plan == 'free' &&
        request.resource.data.joinDate is string &&
        request.resource.data.favorites is list && request.resource.data.favorites.size() <= 200 &&
        request.resource.data.watchlist is list && request.resource.data.watchlist.size() <= 200 &&
        request.resource.data.continueWatching is list && request.resource.data.continueWatching.size() <= 200 &&
        request.resource.data.watchMinutes == 0 &&
        request.resource.data.commentsPosted == 0 &&
        request.resource.data.badges is list && request.resource.data.badges.size() == 0 &&
        request.resource.data.accent is string &&
        request.resource.data.createdAt is timestamp;

      // Users may only change their own profile fields. Privilege/vanity fields
      // (plan/joinDate/watchMinutes/badges/commentsPosted) are type- and
      // range-checked when touched so clients can't forge stats.
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'avatar', 'avatarName', 'accent', 'favorites', 'watchlist',
            'continueWatching', 'watchMinutes', 'commentsPosted', 'badges']) &&
        (!('watchMinutes' in request.resource.data) ||
          (request.resource.data.watchMinutes is number &&
            request.resource.data.watchMinutes >= 0 && request.resource.data.watchMinutes <= 1000000)) &&
        (!('commentsPosted' in request.resource.data) ||
          (request.resource.data.commentsPosted is int &&
            request.resource.data.commentsPosted >= 0 && request.resource.data.commentsPosted <= 100000)) &&
        (!('badges' in request.resource.data) ||
          (request.resource.data.badges is list && request.resource.data.badges.size() <= 20)) &&
        (!('favorites' in request.resource.data) || request.resource.data.favorites is list) &&
        (!('watchlist' in request.resource.data) || request.resource.data.watchlist is list) &&
        (!('continueWatching' in request.resource.data) || request.resource.data.continueWatching is list);
      allow delete: if false;

      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Owners can write their own notifications; anyone signed in may deliver
        // a strictly-shaped "reply" notification to a comment's author.
        allow create: if request.auth != null &&
          (request.auth.uid == userId ||
            (request.resource.data.keys().hasOnly([
              'title', 'body', 'type', 'animeId', 'episode', 'sender',
              'senderAvatar', 'commentId', 'read', 'createdAt',
            ]) &&
            request.resource.data.type == 'reply' &&
            request.resource.data.read == false &&
            request.resource.data.title is string &&
            request.resource.data.title.size() <= 200 &&
            request.resource.data.body is string &&
            request.resource.data.body.size() <= 200 &&
            request.resource.data.sender is string &&
            request.resource.data.sender.size() <= 30 &&
            request.resource.data.senderAvatar is string &&
            request.resource.data.animeId is string &&
            request.resource.data.episode is int &&
            request.resource.data.commentId is string &&
            request.resource.data.createdAt is timestamp));
        allow update: if request.auth != null && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
          request.resource.data.read is bool;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /comments/{animeId}/episodes/{episode}/messages/{commentId} {
      allow read: if true;

      allow create: if canCreateComment([
        'name', 'avatar', 'uid', 'text', 'createdAt', 'likes', 'dislikes',
        'likedBy', 'dislikedBy', 'containsSpoiler', 'badges',
        'animeId', 'episode', 'animeTitle', 'animeCover',
      ]);

      allow update: if request.auth != null &&
        request.auth.uid is string &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'dislikes', 'likedBy', 'dislikedBy', 'pinned', 'pinnedBy']) &&
        // Pin changes are owner-only; everyone else may only adjust likes.
        (request.auth.uid == resource.data.uid ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes', 'dislikes', 'likedBy', 'dislikedBy']));

      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.uid;

      match /replies/{replyId} {
        allow read: if true;

        allow create: if canCreateComment([
          'name', 'avatar', 'uid', 'text', 'createdAt', 'likes', 'dislikes',
          'likedBy', 'dislikedBy', 'containsSpoiler', 'badges',
        ]);

        allow update: if request.auth != null &&
          request.auth.uid is string &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes', 'dislikes', 'likedBy', 'dislikedBy']);

        allow delete: if request.auth != null &&
          request.auth.uid == resource.data.uid;
      }
    }
  }
}
